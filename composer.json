{
    "name": "mitopp/schema-org-bundle",
    "description": "A Builder for Schema.org Graph Types",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mitopp\\SchemaOrgBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mitopp\\SchemaOrgBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Michael Topp",
            "email": "michael.topp@outlook.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.28",
        "symfony/http-kernel": "^6.4|^7.4|^8.0|^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.5",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@composer audit",
            "@php:cs",
            "@rector",
            "@php:stan",
            "@php:unit"
        ],
        "php:cs": "./vendor/bin/php-cs-fixer check --diff",
        "php:cs:fix": "./vendor/bin/php-cs-fixer fix",
        "php:stan": "./vendor/bin/phpstan analyse",
        "php:unit": "./vendor/bin/phpunit",
        "rector": "./vendor/bin/rector process --no-progress-bar --dry-run",
        "rector:fix": "./vendor/bin/rector process",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    }
}
